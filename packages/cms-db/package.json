{
  "name": "@repo/cms-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun run ./src/scripts/migrate.ts",
    "db:reset": "bun run ./src/scripts/reset.ts",
    "db:seed": "bun run ./src/scripts/seed.ts",
    "db:seed:scale": "bun run ./src/scripts/seed-scale.ts",
    "db:benchmark": "bun run ./src/scripts/benchmark.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.2"
  }
}

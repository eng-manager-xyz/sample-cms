{
  "name": "@repo/cms-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm --external react",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.2"
  }
}

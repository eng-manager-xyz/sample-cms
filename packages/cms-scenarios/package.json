{
  "name": "@repo/cms-scenarios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun --format esm",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "seed": "bun run ./src/cli.ts seed",
    "prove": "bun run ./src/cli.ts prove",
    "benchmark": "bun run ./src/cli.ts benchmark",
    "report": "bun run ./src/cli.ts report",
    "integration": "bun run ./src/cli.ts integration"
  },
  "dependencies": {
    "@repo/cms-db": "workspace:*",
    "@repo/cms-domain": "workspace:*",
    "@repo/cms-service": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "6.0.2"
  }
}
